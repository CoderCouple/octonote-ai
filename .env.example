DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
WEB_ORIGIN="http://localhost:3000"
# Base for share-email links and /pub/<slug> URLs.
PUBLIC_APP_URL="http://localhost:3000"

# Transactional email (Resend). Leave empty in local dev — share emails are logged instead.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
# RESEND_FROM="Octonote <noreply@octonote.ai>"

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Required on any non-localhost domain: tldraw v5+ hides the canvas after 5s without it.
# Free watermarked key via sales@tldraw.com; paid Business key removes the watermark.
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY="tldraw-..."

# DEVELOPMENT ONLY — auto sign-in so you don't log in on every visit.
# `pnpm dev:user` creates this user in the local Supabase (refuses non-local URLs).
# Web reads the NEXT_PUBLIC_* copies from apps/web/.env.local; mobile reads EXPO_PUBLIC_* from apps/mobile/.env.
# Never set *_DEV_AUTO_LOGIN in a deployed environment.
DEV_LOGIN_EMAIL="dev@octonote.local"
DEV_LOGIN_PASSWORD="octonote-dev-only"
# NEXT_PUBLIC_DEV_AUTO_LOGIN="true"
# NEXT_PUBLIC_DEV_LOGIN_EMAIL="dev@octonote.local"
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD="octonote-dev-only"
# EXPO_PUBLIC_DEV_AUTO_LOGIN="true"
# EXPO_PUBLIC_DEV_LOGIN_EMAIL="dev@octonote.local"
# EXPO_PUBLIC_DEV_LOGIN_PASSWORD="octonote-dev-only"
