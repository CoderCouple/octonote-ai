{
  "name": "@octonote/content",
  "version": "0.1.0",
  "private": true,
  "description": "Octonote content formats: markdown <-> note blocks (BlockNote), diagrams -> octodraw canvases, and old tldraw canvases -> octodraw. No app or API code.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/server.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "echo \"lint pending\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@blocknote/core": "0.51.4",
    "@blocknote/server-util": "0.51.4",
    "@dagrejs/dagre": "3.1.1",
    "@octonote/octodraw": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
