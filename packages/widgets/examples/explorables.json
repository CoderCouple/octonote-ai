  {
    "schemaVersion": "1.0",
    "type": "widget",
    "id": "dice-six",
    "title": "At least one six",
    "badge": "Probability",
    "description": "Pick how many dice to roll, then run the experiment and watch the estimate settle onto the theory.",
    "inputs": [
      {
        "kind": "slider",
        "id": "n",
        "label": "Dice per roll",
        "min": 1,
        "max": 12,
        "value": 4
      }
    ],
    "values": [
      {
        "name": "theory",
        "formula": "1 - (5/6)^n"
      }
    ],
    "views": [
      {
        "type": "sentence",
        "text": "Roll [n] dice. The chance that at least one shows a six is 1 − (5/6)^n = **{theory|percent}**."
      },
      {
        "type": "simulation",
        "trials": "1000",
        "outcome": "binomial(n, 1/6)",
        "success": "outcome >= 1",
        "expected": "theory",
        "label": "Rolls with a six",
        "histogram": true
      }
    ],
    "note": "The histogram counts how many sixes each roll had."
  },
