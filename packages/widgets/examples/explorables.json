  {
    "schemaVersion": "1.0",
    "type": "widget",
    "id": "tangent-slope",
    "title": "Slope of a curve",
    "badge": "Calculus",
    "description": "Drag the point along the curve. The orange line touches the curve there, and its slope is the derivative.",
    "inputs": [
      {
        "kind": "slider",
        "id": "a",
        "label": "Point at x",
        "min": -3,
        "max": 3,
        "step": 0.1,
        "value": 1
      }
    ],
    "values": [
      {
        "name": "slope",
        "formula": "2 * a"
      }
    ],
    "views": [
      {
        "type": "chart",
        "x": {
          "from": -3,
          "to": 3,
          "step": 0.1
        },
        "series": [
          {
            "label": "y = x²",
            "y": "x^2",
            "color": "blue"
          },
          {
            "label": "Tangent line",
            "y": "slope * (x - a) + a^2",
            "color": "orange"
          }
        ],
        "y": {
          "min": -2,
          "max": 9
        },
        "handles": [
          {
            "input": "a",
            "x": "a",
            "y": "a^2",
            "label": "slope {slope|1}",
            "color": "orange"
          }
        ]
      },
      {
        "type": "formula",
        "tex": true,
        "text": "\\left.\\frac{d}{dx}x^2\\right|_{x={{a|1}}} = 2 \\cdot ({{a|1}}) = {{slope|1}}"
      },
      {
        "type": "sentence",
        "text": "At x = [a], the curve rises {slope|1} for every 1 step right, so the derivative of x² there is **{slope|1}** (which is 2x)."
      }
    ]
  },
