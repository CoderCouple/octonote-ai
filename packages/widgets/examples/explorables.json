  {
    "schemaVersion": "1.0",
    "type": "widget",
    "id": "investment-sentence",
    "title": "Investing, in one sentence",
    "badge": "Finance",
    "description": "Drag the blue numbers left and right.",
    "inputs": [
      {
        "kind": "slider",
        "id": "principal",
        "label": "Amount invested",
        "min": 100,
        "max": 20000,
        "step": 100,
        "value": 1000,
        "format": {
          "style": "currency"
        }
      },
      {
        "kind": "slider",
        "id": "rate",
        "label": "Annual return",
        "min": 0,
        "max": 15,
        "step": 0.5,
        "value": 7,
        "format": {
          "suffix": "%"
        }
      },
      {
        "kind": "slider",
        "id": "years",
        "label": "Years",
        "min": 1,
        "max": 40,
        "value": 15,
        "play": true
      }
    ],
    "values": [
      {
        "name": "balance",
        "formula": "principal * (1 + rate/100)^years"
      },
      {
        "name": "gain",
        "formula": "balance - principal"
      }
    ],
    "views": [
      {
        "type": "sentence",
        "text": "If you invest [principal] at [rate] a year for [years] years, you'll end up with **{balance|currency}**, and {gain|currency} of that is interest."
      },
      {
        "type": "chart",
        "chart": "area",
        "x": {
          "from": 0,
          "to": 40,
          "label": "Years"
        },
        "xTo": "years",
        "series": [
          {
            "label": "Balance",
            "y": "principal * (1 + rate/100)^x",
            "color": "green"
          },
          {
            "label": "Money you put in",
            "y": "principal",
            "color": "gray"
          }
        ],
        "y": {
          "format": {
            "style": "currency"
          }
        }
      },
      {
        "type": "input",
        "input": "years"
      }
    ]
  },
  {
    "schemaVersion": "1.0",
    "type": "widget",
    "id": "tangent-slope",
    "title": "Slope of a curve",
    "badge": "Calculus",
    "description": "Drag the point along the curve. The orange line touches the curve there, and its slope is the derivative.",
    "inputs": [
      {
        "kind": "slider",
        "id": "a",
        "label": "Point at x",
        "min": -3,
        "max": 3,
        "step": 0.1,
        "value": 1
      }
    ],
    "values": [
      {
        "name": "slope",
        "formula": "2 * a"
      }
    ],
    "views": [
      {
        "type": "chart",
        "x": {
          "from": -3,
          "to": 3,
          "step": 0.1
        },
        "series": [
          {
            "label": "y = x²",
            "y": "x^2",
            "color": "blue"
          },
          {
            "label": "Tangent line",
            "y": "slope * (x - a) + a^2",
            "color": "orange"
          }
        ],
        "y": {
          "min": -2,
          "max": 9
        },
        "handles": [
          {
            "input": "a",
            "x": "a",
            "y": "a^2",
            "label": "slope {slope|1}",
            "color": "orange"
          }
        ]
      },
      {
        "type": "sentence",
        "text": "At x = [a], the curve rises {slope|1} for every 1 step right, so the derivative of x² there is **{slope|1}** (which is 2x)."
      }
    ]
  }
]
