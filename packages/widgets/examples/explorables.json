  {
    "schemaVersion": "1.0",
    "type": "widget",
    "id": "compound-interest",
    "title": "Compound interest",
    "badge": "Finance",
    "description": "Explore how interest rates affect a $1,000 investment over 15 years.",
    "inputs": [
      {
        "kind": "slider",
        "id": "rate",
        "label": "Annual return",
        "min": 0,
        "max": 15,
        "step": 0.5,
        "value": 7,
        "format": {
          "suffix": "%"
        }
      }
    ],
    "values": [
      {
        "name": "balance",
        "formula": "1000 * (1 + rate/100)^15"
      },
      {
        "name": "gain",
        "formula": "balance - 1000"
      }
    ],
    "views": [
      {
        "type": "stats",
        "items": [
          {
            "label": "Investment after 15 years",
            "value": "balance",
            "format": {
              "style": "currency"
            },
            "note": "+{gain|currency} earned"
          }
        ]
      }
    ],
    "note": "Assumes annual compounding with no additional deposits."
  },
