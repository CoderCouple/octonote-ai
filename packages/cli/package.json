{
  "name": "@octonote/cli",
  "version": "0.1.4",
  "description": "The octonote command-line tool: lets you — and agents like Claude Code and Codex — create, edit, publish and share Octonote notes, canvases, projects and notebooks.",
  "homepage": "https://octonote.ai/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderCouple/octonote-ai.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "octonote": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/gen-reference.mjs && node scripts/gen-docs.mjs",
    "dev": "tsx src/index.ts",
    "lint": "echo \"lint pending\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:reference": "node scripts/gen-reference.mjs --check && node scripts/gen-docs.mjs --check"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "octonote",
    "cli",
    "notes",
    "canvas",
    "mermaid",
    "claude",
    "codex",
    "ai-agent"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
