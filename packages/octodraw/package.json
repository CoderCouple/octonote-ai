{
  "name": "@octonote/octodraw",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Diagram-as-code canvas for React (Eraser-compatible syntax): architecture, ERD, sequence and BPMN diagrams, a free-form canvas, AI assistant and real-time collaboration.",
  "exports": {
    ".": "./src/index.ts",
    "./collab": "./src/collab/index.ts",
    "./prompt": "./src/ai/prompt.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./collab": {
        "types": "./dist/types/collab/index.d.ts",
        "import": "./dist/collab.js"
      },
      "./prompt": {
        "types": "./dist/types/ai/prompt.d.ts",
        "import": "./dist/prompt.js"
      }
    },
    "types": "./dist/types/index.d.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "icons:eraser": "node scripts/generate-eraser-icons.mjs",
    "icons:vendor": "node scripts/generate-vendor-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide": "^1.61.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@eraserlabs/layout": "0.3.0",
    "elkjs": "^0.12.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.8.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
